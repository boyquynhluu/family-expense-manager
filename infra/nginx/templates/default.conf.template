# Reverse proxy for the VPS (docker-compose.prod.yml). The official nginx image renders this template into
# /etc/nginx/conf.d/default.conf at startup, substituting ONLY variables that exist in its environment
# (${DOMAIN}) — nginx's own $host, $remote_addr... are left untouched.
# Certificates: issued by infra/init-letsencrypt.sh, renewed by the certbot container (webroot below);
# nginx reloads itself every 6h to pick up a renewed certificate.

# --- Per-IP flood protection (this file is included at http{} level, so the zones can live here) ---
# Stops one client from swamping the JVMs: excess requests are refused here with 429, before reaching Java.
# Rates are per client address — every IPv6 device has its own, so family members don't share a budget.
# The gateway's RateLimitFilter still adds its much tighter per-endpoint limits on login/register/... on top.
#   fem_api:  20 req/s sustained, bursts of 40 absorbed at once (a dashboard fires ~10 API calls on load).
#   fem_web:  static SPA files; looser, a cold page load pulls a handful of JS/CSS/font files.
#   fem_conn: open connections per client (HTTP/2 multiplexes, so a browser needs only 1-2).
limit_req_zone  $binary_remote_addr zone=fem_api:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=fem_web:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=fem_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# --- HTTP: Let's Encrypt challenge + redirect everything else to HTTPS ---
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Receipt images are uploaded through the API — a bit more than the backend's own limit.
    client_max_body_size 12m;

    limit_conn fem_conn 30;
    # Same JSON shape as the gateway's RateLimitFilter, so the frontend shows the message either way.
    error_page 429 = @too_many_requests;
    location @too_many_requests {
        default_type application/json;
        add_header Retry-After 1 always;
        return 429 '{"message":"Quá nhiều yêu cầu, vui lòng thử lại sau."}';
    }

    # Docker's embedded DNS, re-asked every 10s. A deploy recreates api-gateway/frontend with NEW IPs; a plain
    # `proxy_pass http://frontend:80` is resolved once when nginx starts and would keep hitting the old IPs (502)
    # until nginx restarts. A variable in proxy_pass makes nginx resolve the name per request via this resolver.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $fem_gateway http://api-gateway:8080;
    set $fem_frontend http://frontend:80;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Renewal challenge over HTTPS too: with Cloudflare's "Always Use HTTPS", Let's Encrypt's http:// check is
    # redirected at the edge and arrives here on 443.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Health/metrics stay internal (they are not under /api anyway — this is belt and braces).
    location ~ ^/(api/)?actuator {
        return 404;
    }

    # REST API + OAuth2 login/callback → api-gateway. X-Forwarded-* lets the backend build https://${DOMAIN}
    # URLs (OAuth2 redirect) and find the real client IP (ClientIpFilter uses the right-most X-Forwarded-For).
    location /api/ {
        limit_req zone=fem_api burst=40 nodelay;
        proxy_pass $fem_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # One value: the client IP nginx saw, never a client-supplied list (the gateway reads the right-most X-Forwarded-For).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 120s;
    }

    # Everything else → the React build (its own nginx handles SPA routes).
    location / {
        limit_req zone=fem_web burst=100 nodelay;
        proxy_pass $fem_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
