# Copy to .env.prod on the VPS (never commit .env.prod) and fill in every value:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Random secrets:  openssl rand -base64 48   (passwords)   /   openssl rand -base64 64   (JWT_SECRET)

# --- Domain / HTTPS (nginx + Let's Encrypt) ---
DOMAIN=chitieu.example.com
# Let's Encrypt account email (expiry warnings).
LETSENCRYPT_EMAIL=you@example.com

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
FEM_AUTH_DB_USER=fem_auth
FEM_AUTH_DB_PASSWORD=change-me
FEM_EXPENSE_DB_USER=fem_expense
FEM_EXPENSE_DB_PASSWORD=change-me
FEM_NOTIFY_DB_USER=fem_notify
FEM_NOTIFY_DB_PASSWORD=change-me

# --- Security ---
# At least 64 random characters. Changing it later logs everyone out.
JWT_SECRET=change-me
# AES key for stored 2FA secrets. Moving an EXISTING database: reuse the current key,
# or put the old one in TOTP_ENCRYPTION_KEY_PREVIOUS so stored secrets get re-encrypted.
TOTP_ENCRYPTION_KEY=change-me
TOTP_ENCRYPTION_KEY_PREVIOUS=

# --- Email (SMTP) ---
# Gmail: smtp.gmail.com / 587 / an App Password (not your Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=change-me
MAIL_FROM=Family Expense <you@gmail.com>

# --- Social login (optional; leave empty to disable) ---
# Google Console → Authorized redirect URI: https://<DOMAIN>/api/auth/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Housekeeping ---
TRASH_RETENTION_DAYS=30

# --- Monitoring (only with --profile monitoring) ---
GRAFANA_ADMIN_PASSWORD=change-me
