# Settings for infra/batch/bin/*.sh — copy to conf/batch.env on the VPS (not committed) and fill in.
# Everything here is exported to the scripts (lib/common.sh → load_env).

# Where the per-task flock files go (the deploy user can write /tmp; /var/lock needs root).
LOCK_DIR=/tmp

# Failure/warning notifications (lib/notify.sh). Leave empty to only log them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used by bin/example-task.sh.
DISK_WARN_PERCENT=85
