{
  "title": "VPS & Containers",
  "uid": "fem-vps",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU used",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM used",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Disk used (/)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - node_boot_time_seconds"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU usage (%) and load average",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU %"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load1",
          "legendFormat": "load 1m"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "CPU cores"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "swap used"
        }
      ]
    },
    {
      "id": 7,
      "title": "Container memory (working set)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(container_memory_working_set_bytes{name=~\"fem-.+\"}) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Container memory vs mem_limit (%)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(container_memory_working_set_bytes{name=~\"fem-.+\"}) by (name) / sum(container_spec_memory_limit_bytes{name=~\"fem-.+\"} > 0) by (name)",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Container CPU (% of one core)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{name=~\"fem-.+\"}[5m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Container network (received / sent)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\"fem-.+\"}[5m])) by (name)",
          "legendFormat": "{{name}} in"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "-sum(rate(container_network_transmit_bytes_total{name=~\"fem-.+\"}[5m])) by (name)",
          "legendFormat": "{{name}} out"
        }
      ]
    },
    {
      "id": 11,
      "title": "Containers OOM-killed (last 24h) — empty = none",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(container_oom_events_total{name=~\"fem-.+\"}[24h])) by (name) > 0",
          "legendFormat": "{{name}}",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
