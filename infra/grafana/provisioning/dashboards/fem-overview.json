{
  "title": "Family Expense Manager - Overview",
  "uid": "fem-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate (req/s)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx error rate (req/s)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{outcome=\"SERVER_ERROR\"}[5m])) by (application) or sum(rate(http_server_requests_seconds_count[5m])) by (application) * 0",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM heap used (bytes)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Service uptime",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_uptime_seconds",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Response time p95 by service (95% of requests are faster)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])) by (le, application))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "api-gateway response time p50 / p95 / p99 (what users see)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"api-gateway\", uri!~\"/actuator.*\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"api-gateway\", uri!~\"/actuator.*\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"api-gateway\", uri!~\"/actuator.*\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "title": "Slowest endpoints — p95 over the selected time range",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application!~\"api-gateway|eureka-server\", uri!~\"/actuator.*|UNKNOWN|root\"}[$__range])) by (le, application, uri)) > 0)",
          "legendFormat": "{{application}} {{uri}}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Requests slower than 1s (%)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - sum(rate(http_server_requests_seconds_bucket{le=\"1.0\", uri!~\"/actuator.*\"}[5m])) by (application) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])) by (application))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Circuit breakers not closed (1 = open / half-open)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 0 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(resilience4j_circuitbreaker_state{state=~\"open|half_open|forced_open\"}) by (application, name)",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Circuit breaker failure rate (%)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(resilience4j_circuitbreaker_failure_rate) by (application, name) >= 0",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Calls short-circuited by an open breaker (per min)",
      "type": "timeseries",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "fieldConfig": { "defaults": { "min": 0 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "60 * sum(rate(resilience4j_circuitbreaker_not_permitted_calls_total[5m])) by (application, name)",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Container logs (all services)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{compose_project=\"family-expense-manager\"}"
        }
      ]
    }
  ]
}
