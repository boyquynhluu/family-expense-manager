# Copy this file to .env in the same folder before running `docker compose up`.

# Oracle
ORACLE_PASSWORD=change-me
ORACLE_SERVICE=FREEPDB1

FEM_AUTH_DB_USER=fem_auth
FEM_AUTH_DB_PASSWORD=change-me
FEM_EXPENSE_DB_USER=fem_expense
FEM_EXPENSE_DB_PASSWORD=change-me
FEM_NOTIFY_DB_USER=fem_notify
FEM_NOTIFY_DB_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-super-secret
